# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ExchangeRate-API
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# FedEx — Rate API (shipping cost calculation)
FEDEX_CLIENT_ID=your-fedex-rate-client-id
FEDEX_CLIENT_SECRET=your-fedex-rate-client-secret
FEDEX_ACCOUNT_NUMBER=your-fedex-account-number
FEDEX_API_URL=https://apis.fedex.com

# FedEx — Basic Visibility / Tracking API (separate credentials)
FEDEX_API_KEY=your-fedex-tracking-api-key
FEDEX_SECRET_KEY=your-fedex-tracking-secret-key

# Midtrans API Keys
# Get these from https://dashboard.midtrans.com → Settings → Access Keys

# Server Key — NEVER expose this to the client
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx

# Client Key — safe to expose to the browser
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx

# Set to "true" for production, "false" for sandbox
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
